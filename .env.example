# Slack
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_DEFAULT_CHANNEL_ID=C00000000
PROJECT_CHANNEL_MAP=
ENABLED_PROJECT_IDS=

# Mentions: needs the `users:read` bot scope. When off (or when the scope is
# missing) the author and reviewers are posted as plain names with no ping.
SLACK_MENTIONS=true
# Overrides for people whose GitLab username differs from their Slack handle:
# SLACK_USER_MAP=jan.kowalski=U01ABCDEF,anna.nowak=U02GHIJKL
SLACK_USER_MAP=
SLACK_DIRECTORY_REFRESH_MS=900000

# GitLab
GITLAB_WEBHOOK_SECRET=REPLACE-ME
GITLAB_BASE_URL=https://gitlab.example.com

# Jira
# Always compiled case-insensitively, and the match is upper-cased before use,
# so `abc-1234` and `ABC-1234` both yield [ABC-1234].
JIRA_KEY_REGEX=[A-Z][A-Z0-9]+-\d+
# Set to make the ticket key a link (<base>/browse/KEY). Left unset, it stays plain text.
# JIRA_BASE_URL=https://jira.example.com

# Runtime
DATABASE_URL=file:./data/app.db
PORT=8080
LOG_LEVEL=info
WORKER_POLL_MS=500

# Dev only: serves the GitLab webhook simulator at GET /dev/simulator.
# Leave off in production.
DEV_SIMULATOR=false
