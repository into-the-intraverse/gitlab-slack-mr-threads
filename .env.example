# Routing, mentions and Jira settings are NOT here any more. They live in the
# database and are edited from the bot's App Home page in Slack. This file keeps
# secrets, the deployment shape, and the few knobs that need a restart anyway.

# Slack
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_DIRECTORY_REFRESH_MS=900000
# Slack user IDs that may change settings, on top of workspace admins and owners.
SLACK_ADMIN_USER_IDS=
# App-level token (xapp-...) with connections:write. Leave empty to run without
# the settings panel.
SLACK_APP_TOKEN=
# Where the Slack Web API lives. Empty means slack.com; set it to route through
# an egress proxy. Must end with a slash.
SLACK_API_URL=

# GitLab
GITLAB_WEBHOOK_SECRET=REPLACE-ME
GITLAB_BASE_URL=https://gitlab.example.com

# Runtime
DATABASE_URL=file:./data/app.db
PORT=8080
LOG_LEVEL=info
WORKER_POLL_MS=500

# Dev only: serves the GitLab webhook simulator at GET /dev/simulator.
# Leave off in production.
DEV_SIMULATOR=false
